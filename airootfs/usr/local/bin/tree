#!/bin/sh

args=()
for arg in "$@"; do
    if [ "$arg" = "-leaf" ]; then
        args+=("-S")
    elif [ "$arg" = "-grow" ]; then
        args+=("-Syu")
    elif [ "$arg" = "-opsec" ]; then
        args+=("-Sy")
    elif [ "$arg" = "-fell" ]; then
        args+=("-Rns")
    elif [ "$arg" = "-branch" ]; then
        args+=("-Syy")
    else
        args+=("$arg")
    fi
done

exec /usr/bin/pacman "${args[@]}"



# Add Syu
# Add Sy
# Add Rns
# Add Syy
