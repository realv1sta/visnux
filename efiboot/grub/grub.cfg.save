k# Load graphical terminal and image formats
insmod all_video
insmod font
insmod png

if loadfont /boot/grub/fonts/unicode.pf2 ; then
    set gfxmode=auto
    insmod gfxterm
    terminal_output gfxterm
fi

# Set background splash image
insmod gfxmenu

# Menu appearance options (optional)
set color_normal=white/black
set color_highlight=black/white

# Boot Defaults
set default="0"
set timeout=15

# Menu Entries
menuentry "Visnux install medium (x86_64, UEFI)" --class arch --class gnu-linux --class gnu --class os {
    set gfxpayload=keep
    linux /arch/boot/x86_64/vmlinuz-linux archisobasedir=arch archisolabel=ARCH_202610
    initrd /arch/boot/x86_64/initramfs-linux.img
}

menuentry "UEFI Shell" {
    insmod chain
    chainloader /shellx64.efi
}

menuentry "UEFI Firmware Settings" {
    fwsetup
}
